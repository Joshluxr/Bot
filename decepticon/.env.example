# Decepticon — OpenAI-Compatible Provider Configuration
# Copy to ~/.decepticon/.env or export before `decepticon onboard`
#
# Branch: devin/1779921489-openai-compatible-providers
# Docs: https://github.com/PurpleAILAB/Decepticon/blob/main/docs/models.md

# --- OpenAI-compatible gateway (required for this branch setup) ---
CUSTOM_OPENAI_API_BASE=https://your-gateway.example.com/v1
CUSTOM_OPENAI_API_KEY=your-api-key-here
CUSTOM_OPENAI_MODEL=gpt-4o-mini

# Per-agent overrides (optional)
# DECEPTICON_MODEL_ORCHESTRATOR=custom/gpt-4o
# DECEPTICON_MODEL_RECON=custom/gpt-4o-mini
# DECEPTICON_MODEL_EXPLOIT=custom/gpt-4o

# Profile: eco | max | test
DECEPTICON_MODEL_PROFILE=eco

# LiteLLM proxy (set automatically by Docker stack)
# DECEPTICON_LLM__PROXY_URL=http://litellm:4000

# --- Alternative: OpenRouter (OpenAI-compatible) ---
# OPENROUTER_API_KEY=your-openrouter-key
# DECEPTICON_MODEL=openrouter/anthropic/claude-sonnet-4

# --- Alternative: Local Ollama ---
# OLLAMA_API_BASE=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# --- Engagement defaults ---
DECEPTICON_ENGAGEMENT_TARGET=https://lto.gov.ph
